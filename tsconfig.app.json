{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": ["xi-configs/tsconfig/node-app", "./tsconfig.base.json"],
	"compilerOptions": {
		"composite": true,
		"declaration": true,
		"declarationDir": "./node_modules/.cache/types/app",
		"emitDeclarationOnly": true,
		"noEmit": false,
		"rootDir": ".",
		"tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo/app.tsbuildinfo"
	},
	"include": ["src/**/*.ts"]
}
