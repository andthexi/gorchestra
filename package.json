{
	"name": "gorchestra",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.19.0",
	"scripts": {
		"lint": "NODE_OPTIONS=--max-old-space-size=8192 eslint .",
		"lint:fix": "NODE_OPTIONS=--max-old-space-size=8192 eslint . --fix",
		"format": "prettier --check .",
		"format:fix": "prettier --write .",
		"typecheck": "NODE_OPTIONS=--max-old-space-size=8192 tsc -b --pretty false",
		"test": "pnpm -r --workspace-concurrency=1 run test",
		"fallow:check": "status=0; fallow --type-aware --format human || status=$?; fallow dupes --fail-on-issues --format human || status=$?; exit \"$status\"",
		"fallow:audit": "fallow audit",
		"commitlint": "commitlint",
		"lint-staged": "lint-staged --concurrent false",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": "eslint --fix",
		"*": "prettier --write --ignore-unknown"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@types/node": "24.19.2",
		"eslint": "10.14.0",
		"eslint-import-resolver-typescript": "4.4.5",
		"fallow": "3.42.0",
		"husky": "^9.1.7",
		"lint-staged": "17.6.0",
		"prettier": "3.10.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "8.72.2",
		"vitest": "5.1.0",
		"xi-configs": "0.1.1"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		],
		"rules": {
			"header-max-length": [
				2,
				"always",
				100
			],
			"subject-case": [
				2,
				"never",
				[
					"sentence-case",
					"start-case",
					"pascal-case",
					"upper-case"
				]
			],
			"scope-case": [
				2,
				"always",
				"lower-case"
			]
		}
	}
}
