{
	"name": "gorchestra",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.19.0",
	"scripts": {
		"dev": "tsx watch --env-file-if-exists=.env src/main.ts --dev | pino-pretty",
		"start": "tsx --env-file-if-exists=.env src/main.ts",
		"check:prepare": "pnpm --filter @gorchestra/core2 --fail-if-no-match --if-present run check:prepare",
		"check:dependencies": "node scripts/check-dependencies.mjs",
		"lint": "NODE_OPTIONS=--max-old-space-size=8192 eslint 'libs/core2/**/*.ts'",
		"lint:fix": "NODE_OPTIONS=--max-old-space-size=8192 eslint 'libs/core2/**/*.ts' --fix",
		"format": "prettier --check libs/core2 docs/core2",
		"format:fix": "prettier --write libs/core2 docs/core2",
		"typecheck": "NODE_OPTIONS=--max-old-space-size=8192 tsc -b libs/core2 --pretty false",
		"test": "pnpm --filter @gorchestra/core2 --fail-if-no-match run test",
		"fallow": "fallow --root libs/core2 --config libs/core2/.fallowrc.json",
		"fallow:check": "status=0; fallow --root libs/core2 --config libs/core2/.fallowrc.json --type-aware --format human || status=$?; fallow dupes --root libs/core2 --config libs/core2/.fallowrc.json --fail-on-issues --format human || status=$?; exit \"$status\"",
		"fallow:audit": "fallow audit --base main --root libs/core2 --config libs/core2/.fallowrc.json",
		"fallow:audit:json": "fallow audit --base main --root libs/core2 --config libs/core2/.fallowrc.json --format json",
		"fallow:health": "fallow health --root libs/core2 --config libs/core2/.fallowrc.json --score",
		"fallow:dead-code": "fallow dead-code --root libs/core2 --config libs/core2/.fallowrc.json",
		"commitlint": "commitlint",
		"lint-staged": "lint-staged --concurrent false",
		"prepare": "husky"
	},
	"lint-staged": {
		"libs/core2/**/*.ts": "eslint --fix",
		"{libs/core2,docs/core2}/**/*.{ts,json,md}": "prettier --write"
	},
	"dependencies": {
		"@gorchestra/consumer-server": "workspace:*",
		"valleyed": "latest"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@types/node": "24.19.2",
		"eslint": "10.14.0",
		"eslint-import-resolver-typescript": "4.4.5",
		"pino-pretty": "13.2.0",
		"fallow": "3.42.0",
		"husky": "^9.1.7",
		"lint-staged": "17.6.0",
		"prettier": "3.10.1",
		"tsx": "4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "8.72.2",
		"vitest": "5.1.0",
		"xi-configs": "0.1.1"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		],
		"rules": {
			"header-max-length": [
				2,
				"always",
				100
			],
			"subject-case": [
				2,
				"never",
				[
					"sentence-case",
					"start-case",
					"pascal-case",
					"upper-case"
				]
			],
			"scope-case": [
				2,
				"always",
				"lower-case"
			]
		}
	}
}
